{
	"name": "lilylet-live-editor",
	"version": "0.0.19",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:docs && vite build",
		"build:docs": "node scripts/build-docs.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "NODE_ENV=production npm run build && gh-pages -d build"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@types/markdown-it": "^14.1.2",
		"@types/pako": "^2.0.4",
		"gh-pages": "^6.3.0",
		"markdown-it-anchor": "^9.2.0",
		"svelte": "^4.2.0",
		"svelte-check": "^3.6.0",
		"typescript": "^5.3.0",
		"vite": "^5.0.0"
	},
	"dependencies": {
		"@codemirror/commands": "^6.3.0",
		"@codemirror/lang-javascript": "^6.2.0",
		"@codemirror/language": "^6.10.0",
		"@codemirror/state": "^6.4.0",
		"@codemirror/theme-one-dark": "^6.1.0",
		"@codemirror/view": "^6.25.0",
		"@k-l-lambda/lilylet": "^0.1.62",
		"@k-l-lambda/lilylet-markdown": "^0.1.35",
		"@k-l-lambda/music-widgets": "1.0.7",
		"codemirror": "^6.0.0",
		"js-base64": "^3.7.0",
		"lodash": "^4.17.23",
		"markdown-it": "^14.1.0",
		"pako": "^2.1.0",
		"sha1": "^1.1.1",
		"verovio": "^4.3.0",
		"vue": "^3.4.0"
	},
	"optionalDependencies": {
		"@k-l-lambda/lotus": "^1.0.5"
	}
}
